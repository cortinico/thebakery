source "https://rubygems.org"

# The site has its own layouts, so no theme gem. Every plugin listed in _config.yml must be here:
# GitHub Actions builds with `bundle exec jekyll build`, not the GitHub Pages gem.
# To upgrade, run `bundle update`.

gem "jekyll", "~> 4"
gem "rouge", ">= 3.2.1"
gem "kramdown-parser-gfm"
gem "webrick", "~> 1.7"
gem "jekyll-sass-converter", "~> 2.2", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-redirect-from"
  gem "jekyll-sitemap"
  gem "jekyll-feed"
  gem "jemoji"
end
